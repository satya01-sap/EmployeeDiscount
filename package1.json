{
  "name": "EmployeeDiscount",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/ams": "^3",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/ams-dev": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy EmployeeDiscount --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-employees-management": "cds watch --open employeesmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-discountapp": "cds watch --open com.sap.dis.discountapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employees": "cds watch --open employees/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "ias"
      },
      "[development]": {
        "db": "sqlite",
        "auth": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "attributes": {
                "groups": "Administrators"
              },
              "roles": [
                "discount.admin"
              ]
            },
            "employee": {
              "password": "employee",
              "attributes": {
                "employeeID": "E000000001"
              },
              "roles": [
                "discount.employee"
              ]
            },
            "content-manager": { 
              "policies": [
                "cap.ContentManager"
              ]
            },
            "stock-manager": { 
              "policies": [
                "cap.StockManager"
              ]
          }
          }
        }
      }
    }
  },
  "sapux": [
    "app/employees-management",
    "app/discountapp",
    "app/employees",
    "app/discountapp"
  ]
}
