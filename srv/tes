service EmployeeService @(requires: 'discount.employee')   {
  @restrict: [{ grant: 'READ', where: 'employeeID = $user' }]
  @readonly 
  entity Employees as projection on discount.Employees;

}

@(path:'/admin')
service AdminService @(requires: 'discount.admin')   {
  entity Employees as projection on discount.Employees;
}

